# JR OS cloud configuration
# Copy to .env.local for local development and add the matching values in Netlify.
# The anon/public key is safe for browser use only when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# local | migration | cloud
# local: browser storage only
# migration: browser storage remains authoritative while records are copied/synchronised
# cloud: cloud repository becomes authoritative, with local cache/offline queue support
NEXT_PUBLIC_JR_OS_CLOUD_MODE=local

# Must remain a private Supabase Storage bucket protected by RLS.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=jr-os-private

# Never add SUPABASE_SERVICE_ROLE_KEY or database passwords to NEXT_PUBLIC variables.

# Stripe SERVER-ONLY sandbox provider stage (not yet exposed as public billing).
# Store credentials in secure deployment settings; never commit real values.
# Plugin OAuth does not provide these server credentials.
# This stage rejects live mode and live keys.
STRIPE_MODE=test
STRIPE_ACCOUNT_ID=acct_1UWyMhRxGUITlJWL
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_1UX0fdRxGUITlJWLXoEGdcBE
STRIPE_PRICE_ANNUAL=price_1UX0fpRxGUITlJWLs2gwl34S
# Dedicated nondefault configuration; replace its ID rather than editing issued-link settings.
STRIPE_PORTAL_CONFIGURATION_ID=
APP_ORIGIN=

# Webhook receipt stays disabled until migration, signing secret and worker setup.
JR_OS_BILLING_WEBHOOK_ENABLED=false
# Server-only Supabase credential; never prefix this name with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Worker remains unactivated until hosted migration/risk/acceptance checks.
JR_OS_BILLING_RECONCILIATION_ENABLED=false
# Native scheduled inbox processing; keep off until hosted worker acceptance.
JR_OS_BILLING_SCHEDULE_ENABLED=false

# Only enable after real hosted sandbox acceptance and operational reconciliation.
JR_OS_BILLING_CHECKOUT_ENABLED=false
JR_OS_BILLING_PORTAL_ENABLED=false
JR_OS_BILLING_SANDBOX_VERIFIED=false
