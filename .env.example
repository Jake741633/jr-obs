# JR OS cloud configuration
# Copy to .env.local for local development and add the matching values in Netlify.
# The anon/public key is safe for browser use only when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# local | migration | cloud
# local: browser storage only
# migration: browser storage remains authoritative while records are copied/synchronised
# cloud: cloud repository becomes authoritative, with local cache/offline queue support
NEXT_PUBLIC_JR_OS_CLOUD_MODE=local

# Must remain a private Supabase Storage bucket protected by RLS.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=jr-os-private

# Never add SUPABASE_SERVICE_ROLE_KEY or database passwords to NEXT_PUBLIC variables.
